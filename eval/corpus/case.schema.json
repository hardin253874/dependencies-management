{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dep-agent-eval/case.schema.json",
  "title": "Eval corpus case",
  "description": "One upgrade case. Editor aid only: eval/lib/corpus.ts is the authoritative validator (`npm run eval -- validate`). Public cases: one file per case at eval/corpus/cases/<id>.json. Private cases: the `cases` array of the gitignored eval/corpus.local.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "repo", "baseCommit", "phases"],
  "definitions": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "version": { "type": ["string", "null"], "minLength": 1 },
    "stringArray": { "type": "array", "items": { "type": "string" } }
  },
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,60}$", "description": "Unique across both corpora; equals the file name without .json" },
    "repo": { "type": "string", "description": "https URL (public); an absolute local path is allowed only in corpus.local.json" },
    "baseCommit": { "$ref": "#/definitions/sha", "description": "Full SHA checked out and scanned (the commit before the upgrade)" },
    "projectDirs": { "type": "array", "minItems": 1, "items": { "type": "string" }, "default": ["."], "description": "Repo-relative POSIX dirs to scan; no '..'" },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "toCommit", "packages"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,40}$" },
          "toCommit": { "$ref": "#/definitions/sha", "description": "Truth range = previous phase's toCommit (or baseCommit) .. toCommit" },
          "packages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "from", "to"],
              "properties": {
                "name": { "type": "string", "description": "npm package name" },
                "from": { "$ref": "#/definitions/version", "description": "null when the phase adds the package" },
                "to": { "$ref": "#/definitions/version", "description": "null when the phase removes the package" }
              }
            }
          },
          "tags": { "$ref": "#/definitions/stringArray" }
        }
      }
    },
    "tags": { "$ref": "#/definitions/stringArray" },
    "truthExcludeGlobs": { "$ref": "#/definitions/stringArray", "description": "gitignore-style globs for generated/irrelevant paths" },
    "source": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Provenance, e.g. { \"pr\": \"https://…\" }" },
    "goldenFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "phase", "title", "category", "expected", "verified"],
        "properties": {
          "id": { "type": "string", "pattern": "^[^|\\s]+$" },
          "phase": { "type": "string", "description": "An existing phase id" },
          "title": { "type": "string", "minLength": 1 },
          "category": { "type": "string" },
          "expected": { "enum": ["yes", "partial", "no", "l3"] },
          "evidenceFiles": { "$ref": "#/definitions/stringArray" },
          "verified": { "type": "boolean" }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
