{
  "name": "dependencies-management-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Locally-run AI-augmented dependencies analysis agent for legacy JS/TS projects",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
