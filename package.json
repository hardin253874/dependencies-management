    "@yarnpkg/parsers": "3.0.0",
    "ignore": "5.3.1",
    "next": "16.4.6",
    "npm-registry-fetch": "19.1.1",
    "p-limit": "5.0.0",
    "p-queue": "8.0.1",
    "p-retry": "6.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.6.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.6",
